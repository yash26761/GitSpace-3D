# GitSpace 3D — Environment Variables Configuration
# STRICT SECURITY NOTICE:
# Never commit .env or .env.local containing real credentials.
# Public metadata exploration operates completely unauthenticated (60 req/hr).

# Optional GitHub Personal Access Token (Server-Side Only)
# Elevates GitHub REST API rate limits from 60 requests/hour to 5,000 requests/hour.
# This variable must NEVER be prefixed with NEXT_PUBLIC_
GITHUB_TOKEN=

# GitHub OAuth / NextAuth (Optional Future Extension)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
